# Canvas Conductor Configuration — example template.
#
# To use: `cp config.toml.example config.toml`, then edit your local
# copy. The live `config.toml` is gitignored so your course ids and any
# instructor-specific paths stay out of the public repository.
#
# Safe to commit: this template file (no secrets).
# Never commit: your live `config.toml` (course ids are not secret but
# are user-specific) or your `.env` (which holds your Canvas token).

[defaults]
# Default output format for all commands: table, json, or csv.
output_format = "table"

# Number of results per API page (max 100, recommended 100).
per_page = 100

# Require confirmation before destructive operations (delete, overwrite).
# Set to false if you prefer --yes flag workflows.
confirm_destructive = true

# IANA timezone used to interpret bare calendar dates (`--due 2026-09-15`,
# `--todo 2026-09-15`). Canvas stores everything in UTC; without this,
# "Sept 15" would mean 11:59 PM UTC — which is 5:59 PM Mountain, i.e. six
# hours earlier than anyone intends. Defaults to the machine's local zone.
timezone = "America/Denver"


# Course Definitions
# ------------------
# Each [courses.<key>] block defines a course you manage.
# The <key> is a short alias used with the --course / -c flag.
#
# Examples:
#   conductor modules list --course mycourse
#   conductor pages show welcome --course cs101
#
# If only one course is defined, it is used automatically (no -c needed).

[courses.mycourse]
# Canvas course ID — find it in the course URL: /courses/12345
id = 12345
# Human-readable name (for display in listings).
name = "Course Display Name"
# Term label (for your own reference; not sent to Canvas).
term = "Fall 2026"
# Optional. Block write commands against this course (exit code 9). Reads
# and --dry-run still work; --force overrides with a warning. Use it for
# course shells you don't own — a section maintained centrally by another
# department, or a live course you only ever want to read from.
# readonly = true

# Add additional [courses.<key>] blocks for each course you manage:
#
# [courses.cs101]
# id = 67890
# name = "CS 101: Intro to Computer Science"
# term = "Fall 2026"


# Playbook extension paths (only needed if you use the `playbook` extension).
#
# The playbook extension is project-specific and is NOT bundled with this
# repo. Point CONDUCTOR_EXTENSIONS_DIR at the directory holding it:
#
#     export CONDUCTOR_EXTENSIONS_DIR="$HOME/my-project/extensions"
#
# Per-course nesting: each course that uses the extension gets its own
# [courses.<alias>.playbook] block. The course alias is whatever you pass
# to `-c`. If exactly one course has a [playbook] sub-block, the extension
# auto-resolves it without needing -c.
#
# Paths can be absolute or ~/expandable. Relative paths resolve against the
# directory containing this config.toml.
# Delete the section below if you don't use the playbook extension.
#
# [courses.is-career-playbook]
# id = 35416
# name = "IS Career Playbook (development course)"
# term = "Spring Semester 2026"
#
# [courses.is-career-playbook.playbook]
# # Per-week markdown source files. Anchors within the markdown drive
# # media placement; see canvas-integration/README.md for the full mapping.
# content_dir = "~/code/is-career-playbook/content"
# # Local cache where `nlm` downloads land before being uploaded to Canvas.
# local_media_cache = "/tmp/playbook-media"
# # Registry of NotebookLM-produced assets (notebook_id, artifact_id, type).
# media_urls_file = "~/code/is-career-playbook/canvas-integration/media-urls.toml"
# # Folder name inside the Canvas course where assets are uploaded.
# canvas_media_folder = "playbook-media"
#
# Optional: section-specific to-do dates. When set, deploy attaches
# `student_todo_at` to each page and `due_at` to each assignment so they
# appear in the Canvas To-Do list and Calendar. ISO yyyy-mm-dd format;
# deploy appends T23:59:00Z. Omit the sub-section to deploy without dates.
#
# [courses.is-career-playbook.playbook.schedule]
# step_1_page  = "2026-08-03"
# step_1_due   = "2026-08-09"
# step_2_page  = "2026-08-10"
# step_2_due   = "2026-08-16"
# step_3_page  = "2026-08-17"
# step_3_due   = "2026-08-23"
# step_4_page  = "2026-08-24"
# step_4_due   = "2026-08-30"
# step_5_page  = "2026-08-31"
# step_5_due   = "2026-09-06"
